import { VerticalBox, HorizontalBox, Button } from "std-widgets.slint";

component Key inherits Button {
    in property <string> key-label;
    text: key-label;
    horizontal-stretch: 1;
    min-height: 52px;
}

export component CalculatorWindow inherits Window {
    in-out property <string> display-text: "0";
    callback pressed(string);

    preferred-width: 360px;
    preferred-height: 480px;
    title: "rust-elm calculator (RwStore)";

    VerticalBox {
        padding: 12px;
        spacing: 6px;

        Rectangle {
            background: #2d2d2d;
            border-radius: 4px;
            min-height: 64px;

            Text {
                text: root.display-text;
                color: #f0f0f0;
                font-size: 32px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 4px;
            Key { key-label: "7"; clicked => { root.pressed("7"); } }
            Key { key-label: "8"; clicked => { root.pressed("8"); } }
            Key { key-label: "9"; clicked => { root.pressed("9"); } }
            Key { key-label: "÷"; clicked => { root.pressed("÷"); } }
        }

        HorizontalBox {
            spacing: 4px;
            Key { key-label: "4"; clicked => { root.pressed("4"); } }
            Key { key-label: "5"; clicked => { root.pressed("5"); } }
            Key { key-label: "6"; clicked => { root.pressed("6"); } }
            Key { key-label: "×"; clicked => { root.pressed("×"); } }
        }

        HorizontalBox {
            spacing: 4px;
            Key { key-label: "1"; clicked => { root.pressed("1"); } }
            Key { key-label: "2"; clicked => { root.pressed("2"); } }
            Key { key-label: "3"; clicked => { root.pressed("3"); } }
            Key { key-label: "−"; clicked => { root.pressed("−"); } }
        }

        HorizontalBox {
            spacing: 4px;
            Key { key-label: "C"; clicked => { root.pressed("C"); } }
            Key { key-label: "0"; clicked => { root.pressed("0"); } }
            Key { key-label: "."; clicked => { root.pressed("."); } }
            Key { key-label: "+"; clicked => { root.pressed("+"); } }
        }

        HorizontalBox {
            spacing: 4px;
            Key { key-label: "⌫"; clicked => { root.pressed("⌫"); } }
            Key { key-label: "="; clicked => { root.pressed("="); } }
        }
    }
}
